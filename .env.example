PORT=3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
# Groq is the backup for lesson generation and also powers speech transcription.
GROQ_API_KEY=your-groq-api-key

# Optional: comma-separated model fallback chain.
# GROQ_MODEL=openai/gpt-oss-20b,openai/gpt-oss-120b,qwen/qwen3.8-27b
# Optional task-specific model order; the built-in defaults put the first
# configured model first for core/review and the second first for story/quiz.
# GROQ_FAST_MODEL=openai/gpt-oss-20b
# GROQ_QUALITY_MODEL=openai/gpt-oss-120b
# GROQ_MODELS_CORE=openai/gpt-oss-20b,openai/gpt-oss-120b
# GROQ_MODELS_REVIEW=openai/gpt-oss-20b,openai/gpt-oss-120b
# GROQ_MODELS_STORY=openai/gpt-oss-120b,openai/gpt-oss-20b
# GROQ_MODELS_QUIZ=openai/gpt-oss-120b,openai/gpt-oss-20b

# Optional lesson generation safeguards.
# LESSON_DEADLINE_MS=240000
# LESSON_REQUESTS_PER_MINUTE=10
# MAX_CONCURRENT_LESSONS=3
# MAX_CONCURRENT_LESSONS_PER_USER=1
# GROQ_RETRY_BASE_MS=500
# GROQ_RETRY_MAX_MS=8000

# Optional: comma-separated bootstrap admin e-mails (fallback until
# profiles.is_admin is set via SQL migration 016_admin.sql).
# ADMIN_EMAILS=admin@example.com
